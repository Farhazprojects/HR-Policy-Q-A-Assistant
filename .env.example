# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Adjust the user for your machine.
DATABASE_URL="postgresql://USER@localhost:5432/hr_policy_assistant?schema=public"

# ─── Security ────────────────────────────────────────────────────────────────
# Any long random string. Never commit a real secret.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN=8h

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── AI providers ────────────────────────────────────────────────────────────
# AI_PROVIDER        : gemini | ollama | local
# EMBEDDING_PROVIDER : gemini | ollama | local
#
#   local  — no API key, no network, no cost. Deterministic lexical retrieval and
#            extractive (non-generative) answers. This is the default so the
#            system is demonstrable out of the box. Clearly labelled in the UI.
#   gemini — Google Gemini free tier. Set GEMINI_API_KEY.
#   ollama — fully offline local models. Requires Ollama running.
AI_PROVIDER=local
EMBEDDING_PROVIDER=local

# DEMO_MODE only affects labelling and seeded-data badges. It never causes a
# response to be presented as live AI when it is not.
DEMO_MODE=true

# ─── Google Gemini (free tier) ───────────────────────────────────────────────
# Create a key at https://aistudio.google.com/apikey — server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# gemini-embedding-001 returns 3072 dimensions by default; a narrower width is
# requested explicitly. Changing this requires re-indexing (npm run seed).
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ─── Ollama (local, offline) ─────────────────────────────────────────────────
# ollama pull llama3.1 && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── Retrieval configuration ─────────────────────────────────────────────────
# Prototype configuration values, not empirically optimised constants.
TOP_K=4
RETRIEVAL_THRESHOLD=0.72
CHUNK_TARGET_CHARS=900
CHUNK_OVERLAP_CHARS=150
MAX_CONTEXT_CHUNKS=6
LOCAL_EMBEDDING_DIMENSIONS=512

# ─── Uploads ─────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=20

# ─── Seeding ─────────────────────────────────────────────────────────────────
# Password given to the seeded demonstration accounts.
SEED_PASSWORD=Capstone#2026

# ─── Testing ─────────────────────────────────────────────────────────────────
TEST_DATABASE_URL="postgresql://USER@localhost:5432/hr_policy_assistant_test?schema=public"
