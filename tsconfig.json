{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@ai/*": ["src/ai/*"],
      "@backend/*": ["src/backend/*"],
      "@db/*": ["src/database/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/ai/**/*.ts", "src/backend/**/*.ts", "src/database/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/frontend", "tests", "scripts"]
}
