{
  "name": "hr-policy-qa-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered HR Policy Q&A Assistant \u2014 retrieval-augmented, explainable, policy-grounded. COIT20254 Capstone, CQUniversity Australia.",
  "workspaces": [
    "src/frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "PORT=${API_PORT:-4000} tsx watch src/backend/index.ts",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "build:web": "npm run build -w frontend",
    "start": "node dist/backend/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/frontend/tsconfig.json --noEmit",
    "db:generate": "prisma generate --schema src/database/schema.prisma",
    "db:push": "prisma db push --schema src/database/schema.prisma",
    "db:migrate": "prisma migrate dev --schema src/database/schema.prisma",
    "db:reset": "prisma migrate reset --force --schema src/database/schema.prisma",
    "db:studio": "prisma studio --schema src/database/schema.prisma",
    "seed": "tsx src/database/seeds/seed.ts",
    "seed:pdfs": "tsx src/database/seeds/generate-policy-pdfs.ts",
    "probe": "tsx scripts/demo/probe-retrieval.ts",
    "setup": "npm install && npm run db:generate && npm run db:push && npm run seed",
    "mode": "node -e \"const e=require('fs').readFileSync('.env','utf8');const g=k=>(e.match(new RegExp('^'+k+'=(.*)$','m'))||[,'(unset)'])[1];console.log('generation:',g('AI_PROVIDER'),'| embeddings:',g('EMBEDDING_PROVIDER'),'| model:',g('GEMINI_MODEL'))\"",
    "mode:local": "node scripts/demo/set-mode.mjs local && npm run seed",
    "mode:gemini": "node scripts/demo/set-mode.mjs gemini && npm run seed",
    "mode:ollama": "node scripts/demo/set-mode.mjs ollama && npm run seed",
    "calibrate": "tsx scripts/demo/calibrate-threshold.ts",
    "phrasing": "tsx scripts/demo/phrasing-probe.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^3.11.174",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.0",
    "pdfkit": "^0.15.2",
    "prisma": "^6.2.0",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
