// HR Policy Knowledge Assistant — COIT20254 Capstone (CQUniversity)
// Entities mirror the approved ER model in docs/DATABASE.md.

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  HR_OFFICER
  ADMIN
}

enum DocumentStatus {
  UPLOADED
  EXTRACTING
  CHUNKING
  EMBEDDING
  INDEXED
  FAILED
}

enum AnswerStatus {
  GROUNDED   // retrieval passed threshold, answer generated from policy context
  FALLBACK   // no chunk passed threshold, refusal returned without calling the LLM
  ERROR      // provider or pipeline failure, surfaced safely to the user
}

enum LeaveType {
  ANNUAL
  PERSONAL
  CARERS
  UNPAID
  LONG_SERVICE
}

enum LeaveStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DECLINED
  CANCELLED
}

enum AuditEvent {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  AI_QUERY
  AI_GROUNDED_RESPONSE
  AI_FALLBACK
  POLICY_UPLOAD
  POLICY_INDEXED
  POLICY_INDEX_FAILED
  POLICY_SEARCH
  LEAVE_REQUEST
  POLICY_ACKNOWLEDGED
  ACCESS_DENIED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String // bcrypt hash — never returned by any API
  role      Role     @default(EMPLOYEE)
  jobTitle  String?
  department String?
  isActive  Boolean  @default(true)
  isDemo    Boolean  @default(false) // seeded demonstration account
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions        Question[]
  leaveRequests    LeaveRequest[]
  acknowledgements PolicyAcknowledgement[]
  auditLogs        AuditLog[]
  uploadedPolicies PolicyDocument[]        @relation("UploadedBy")

  @@index([role])
}

model PolicyDocument {
  id            String         @id @default(cuid())
  title         String
  category      String         @default("General")
  version       String         @default("1.0")
  summary       String?
  filePath      String // server-side path, never exposed directly to the client
  originalName  String
  mimeType      String         @default("application/pdf")
  fileSize      Int            @default(0)
  pageCount     Int            @default(0)
  chunkCount    Int            @default(0)
  checksum      String? // sha256 of file bytes — prevents re-embedding unchanged documents
  status        DocumentStatus @default(UPLOADED)
  statusMessage String?
  embeddingModel String?
  requiresAcknowledgement Boolean @default(false)
  isDemo        Boolean        @default(false) // seeded demonstration policy
  effectiveDate DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  uploadedById String?
  uploadedBy   User?   @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  chunks           PolicyChunk[]
  citations        Citation[]
  acknowledgements PolicyAcknowledgement[]

  @@index([status])
  @@index([category])
  @@unique([title, version])
}

model PolicyChunk {
  id         String  @id @default(cuid())
  documentId String
  document   PolicyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunkIndex Int
  page       Int
  section    String  @default("General")
  content    String
  tokenCount Int     @default(0)
  // Embedding vector. Stored as float8[] because pgvector is not guaranteed to be
  // present; the VectorStore abstraction hides this (see backend/src/rag/vectorStore.ts).
  embedding  Float[]
  embeddingModel String?
  createdAt  DateTime @default(now())

  citations Citation[]

  @@index([documentId])
  @@index([page])
  @@unique([documentId, chunkIndex])
}

model Question {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  question String
  answer   String
  status   AnswerStatus @default(GROUNDED)

  // Retrieval evidence — all confidence figures are derived from these,
  // never generated by the language model.
  topSimilarity   Float   @default(0)
  meanSimilarity  Float   @default(0)
  confidence      Float   @default(0) // 0..1, computed by ConfidenceService
  confidenceBand  String  @default("LOW") // HIGH | MEDIUM | LOW
  retrievedCount  Int     @default(0)
  threshold       Float   @default(0.72)
  topK            Int     @default(4)

  llmProvider      String?
  llmModel         String?
  embeddingProvider String?
  generationMode   String? // "generative" | "extractive" — honest labelling of demo mode
  latencyMs        Int     @default(0)
  fallbackReason   String?

  createdAt DateTime @default(now())

  citations Citation[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Citation {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  chunkId    String?
  chunk      PolicyChunk? @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  documentId String?
  document   PolicyDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  documentTitle String
  page          Int
  section       String
  excerpt       String
  similarity    Float
  rank          Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([questionId])
  @@index([documentId])
}

model LeaveRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  leaveType LeaveType
  startDate DateTime
  endDate   DateTime
  totalDays Int         @default(0)
  reason    String
  status    LeaveStatus @default(SUBMITTED)
  // Academic prototype scope: no payroll/HRIS integration is performed.
  isPrototypeWorkflow Boolean @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model PolicyAcknowledgement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentId String
  document   PolicyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  policyVersion  String
  assignedAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  isDemo         Boolean   @default(false)

  @@unique([userId, documentId, policyVersion])
  @@index([userId])
  @@index([documentId])
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  event     AuditEvent
  entity    String? // e.g. "PolicyDocument"
  entityId  String?
  // Non-sensitive contextual metadata only (see docs/AI_GOVERNANCE.md).
  metadata  Json?
  ipAddress String?
  createdAt DateTime   @default(now())

  @@index([event])
  @@index([userId])
  @@index([createdAt])
}
